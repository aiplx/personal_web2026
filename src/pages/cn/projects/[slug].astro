---
import { getCollection, render } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects
    .filter((project) => project.data.public)
    .map((project) => ({
      params: { slug: project.slug },
      props: { project },
    }));
}

const { project } = Astro.props;
const { Content } = await render(project);
---

<BaseLayout title={`${project.data.title} | 项目`} lang="zh">
  <article class="article">
    <header class="article-head">
      <span class="eyebrow">{project.data.track} / {project.data.status}</span>
      <h1>{project.data.title}</h1>
      <p>{project.data.summary}</p>
      <div class="meta">
        {project.data.tools.map((tool) => <span class="tag">{tool}</span>)}
      </div>
      <div class="meta">
        {project.data.targetRoles.map((role) => <span class="tag blue">{role}</span>)}
      </div>
    </header>
    <div class="article-content">
      <Content />
    </div>
  </article>
</BaseLayout>
