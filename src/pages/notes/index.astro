---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import SectionHead from "@/components/SectionHead.astro";
import NoteCard from "@/components/NoteCard.astro";

const notes = (await getCollection("notes"))
  .filter((note) => note.data.public)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout title="Notes | Ping Liang EET Notes" lang="en">
  <section class="container article-head" style="padding-top: 52px;">
    <span class="eyebrow">Notes</span>
    <h1>Small technical notes.</h1>
    <p class="lead">Notes from setting up tools, preparing labs, and working through small technical problems.</p>
  </section>
  <section class="band paper">
    <div class="container">
      <SectionHead kicker="All notes" title="Troubleshooting records" text="Each note keeps the problem, the useful change, and the follow-up details to check." />
      <div class="grid two">
        {notes.map((note) => <NoteCard note={note} lang="en" />)}
      </div>
    </div>
  </section>
</BaseLayout>
