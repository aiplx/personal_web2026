---
import { getCollection } from "astro:content";
import { withBase } from "@/lib/paths";

interface Props {
  lang?: "zh" | "en";
}

const { lang = "en" } = Astro.props;
const isEn = lang === "en";
const deployBase = import.meta.env.BASE_URL.replace(/\/$/, "");
let currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
if (deployBase && currentPath.startsWith(deployBase)) {
  currentPath = currentPath.slice(deployBase.length) || "/";
}

const pathWithoutLang = currentPath.startsWith("/cn")
  ? currentPath.replace(/^\/cn/, "") || "/"
  : currentPath.startsWith("/en")
    ? currentPath.replace(/^\/en/, "") || "/"
    : currentPath;

const sectionBase = isEn ? "" : "cn";
const homeHref = withBase(isEn ? "/" : "/cn");
const projectsHref = withBase(sectionBase ? `/${sectionBase}/projects` : "/projects");
const notesHref = withBase(sectionBase ? `/${sectionBase}/notes` : "/notes");
const aboutHref = withBase(sectionBase ? `/${sectionBase}/about` : "/about");
const enHref = withBase(pathWithoutLang === "/" ? "/" : pathWithoutLang);
const cnHref = withBase(pathWithoutLang === "/" ? "/cn" : `/cn${pathWithoutLang}`);
const hasPublicProjects = (await getCollection("projects")).some((project) => project.data.public);

const isActive = (section: string) => {
  const normalized = pathWithoutLang === "/" ? "/" : pathWithoutLang;
  return normalized === `/${section}` || normalized.startsWith(`/${section}/`);
};
---

<header class="site-header">
  <div class="container nav">
    <a class="brand" href={homeHref}>
      <strong>Ping Liang</strong>
      <span>{isEn ? "Electrical field notes" : "电气学习记录"}</span>
    </a>
    <nav class="nav-links" aria-label="Main navigation">
      {hasPublicProjects && (
        <a href={projectsHref} aria-current={isActive("projects") ? "page" : undefined}>
          {isEn ? "Projects" : "项目"}
        </a>
      )}
      <a href={notesHref} aria-current={isActive("notes") ? "page" : undefined}>{isEn ? "Notes" : "笔记"}</a>
      <a href={aboutHref} aria-current={isActive("about") ? "page" : undefined}>{isEn ? "About" : "关于"}</a>
      <label class="language-switch" aria-label="Language switch">
        <select
          class="language-select"
          onchange="window.location.href=this.value"
        >
          <option value={enHref} selected={isEn}>English</option>
          <option value={cnHref} selected={!isEn}>中文</option>
        </select>
      </label>
    </nav>
  </div>
</header>
