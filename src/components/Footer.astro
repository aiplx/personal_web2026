---
import { withBase } from "@/lib/paths";

const year = new Date().getFullYear();

interface Props {
  lang?: "zh" | "en";
}

const { lang = "en" } = Astro.props;
---

<footer class="site-footer">
  <div class="container footer-inner">
    <a class="footer-name" href={withBase(lang === "en" ? "/" : "/cn")}>Ping Liang</a>
    <span>{lang === "en" ? "Electrical field notes" : "电气学习记录"} / {year}</span>
  </div>
</footer>
