---
import "../styles/global.css";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { withBase } from "@/lib/paths";

interface Props {
  title: string;
  description?: string;
  lang?: "zh" | "en";
}

const {
  title,
  description = "Electrical Engineering Technician portfolio focused on controls, BAS, hardware testing, and field notes.",
  lang = "en",
} = Astro.props;
---

<!doctype html>
<html lang={lang === "zh" ? "zh-CN" : "en"}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#17211e" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600&family=Newsreader:opsz,wght@6..72,400;6..72,500&family=Noto+Sans+SC:wght@400;500;600&display=swap" rel="stylesheet" />
    <link rel="icon" href={withBase("/favicon.svg")} type="image/svg+xml" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#content">{lang === "en" ? "Skip to content" : "跳到正文"}</a>
    <Header lang={lang} />
    <main id="content">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
